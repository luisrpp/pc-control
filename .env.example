# Copy this file to .env and replace every value with your deployment values.
# Choose an HTTP bind address available in the runtime environment. A loopback
# address is appropriate when surrounding infrastructure forwards requests
# locally. The value below is fictitious.
PC_CONTROL_HTTP_LISTEN_ADDR=127.0.0.1:8080

# MAC address of the workstation to wake (fictitious).
PC_CONTROL_WOL_MAC=00:11:22:33:44:55

# LAN broadcast address for the WOL Magic Packet (fictitious documentation
# address; replace with the broadcast address for the workstation's LAN).
PC_CONTROL_WOL_DESTINATION=192.0.2.255

# Optional: omit to use the application's default of 9.
PC_CONTROL_WOL_PORT=9
