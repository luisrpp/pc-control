# Copy this file to .env and replace every value with deployment values.
# All example values below are fictitious; do not put secret contents here.

# Required: HTTP bind address with an explicit port.
PC_CONTROL_HTTP_LISTEN_ADDR=[2001:db8::10]:8080

# Required: MAC address of the workstation to wake.
PC_CONTROL_WOL_MAC=02:00:00:00:00:01

# Required: IPv4 UDP destination for the WOL Magic Packet.
PC_CONTROL_WOL_DESTINATION=192.0.2.255

# Optional; default is 9 when omitted.
PC_CONTROL_WOL_PORT=9

# Required: shutdown SSH host without a port. Status reuses this host.
PC_CONTROL_SHUTDOWN_SSH_HOST=workstation.example.invalid

# Optional; default is 22 when omitted. Status reuses this port.
PC_CONTROL_SHUTDOWN_SSH_PORT=22

# Required: dedicated restricted shutdown account.
PC_CONTROL_SHUTDOWN_SSH_USER=pc-control

# Required: path to the dedicated private-key file mounted read-only.
PC_CONTROL_SHUTDOWN_SSH_PRIVATE_KEY_PATH=/run/secrets/pc-control/shutdown_key

# Required: path to the mounted known_hosts file.
PC_CONTROL_SHUTDOWN_SSH_KNOWN_HOSTS_PATH=/run/secrets/pc-control/known_hosts

# Optional; default is 10s when omitted.
PC_CONTROL_SHUTDOWN_TIMEOUT=10s

# Optional; default is 1s when omitted.
PC_CONTROL_STATUS_PROBE_TIMEOUT=1s
